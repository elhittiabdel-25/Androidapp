<?xml version="1.0" encoding="utf-8"?>
<!-- Re-Iman mark: a gold ring that turns back on itself (renewal) around an eight-pointed star.
     Same drawing as BrandMark in ui/Brand.kt. Everything stays inside the 66dp safe zone. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- renewal ring: 300 degrees clockwise from the upper right to the top -->
    <path
        android:pathData="M73.745,42.6 A22.8,22.8 0 1,1 54,31.2"
        android:strokeColor="#FFE5B54B"
        android:strokeWidth="4.32"
        android:strokeLineCap="round" />
    <!-- arrow head pointing into the gap -->
    <path
        android:fillColor="#FFE5B54B"
        android:pathData="M61.2,31.2 L52.8,24.96 L52.8,37.44 Z" />
    <!-- eight-pointed star: two squares -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M45.09,45.09 L62.91,45.09 L62.91,62.91 L45.09,62.91 Z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M54,41.4 L66.6,54 L54,66.6 L41.4,54 Z" />
    <!-- centre -->
    <path
        android:fillColor="#FFE5B54B"
        android:pathData="M50.88,54 a3.12,3.12 0 1,0 6.24,0 a3.12,3.12 0 1,0 -6.24,0 Z" />
</vector>
